#!/bin/sh
# Weekly Homebrew formula upgrade + vulnerability report.
# Scheduled on macOS by `make schedule` (launchd). Upgrades every formula on the machine (personal + work).
#
# TODO: Make upgrade script general brew upgrade. Incl. casks managed by brew.
#   Run on first system startup so no casks are open on startup.
#   BLOCKER: Currently, temurin@25 requires sudo because it is a .pkg installer
# TODO: Linux scheduling needs a separate agent, as launchd is macOS only.

set -u

if [ "$(uname -s)" = Darwin ]; then
  log="$HOME/Library/Logs/brew-weekly.log"
else
  log="${XDG_STATE_HOME:-$HOME/.local/state}/brew-weekly.log"
fi
mkdir -p "$(dirname "$log")"
exec >>"$log" 2>&1

echo "=== brew-weekly $(date '+%Y-%m-%d %H:%M:%S') ==="

# launchd runs with a minimal PATH, so locate brew by absolute path
brew=""
for p in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
  if [ -x "$p/bin/brew" ]; then
    brew="$p/bin/brew"
    break
  fi
done
if [ -z "$brew" ]; then
  echo "brew not found"
  exit 1
fi
PATH="$(dirname "$brew"):$PATH"
export PATH

status=0
"$brew" update && "$brew" upgrade --formula || status=$?

# Report known CVEs that have a released fix, after the upgrade
"$brew" vulns --fix-available || true

echo "=== done (exit $status) ==="
exit "$status"
