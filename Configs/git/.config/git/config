[core]
	autocrlf = input
	pager = delta

[includeIf "gitdir:/mnt/**"]
	path = ~/.config/git/config-windows
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
  side-by-side = true
  line-numbers = true
	navigate = true
	dark = true
[merge]
	conflictStyle = zdiff3
