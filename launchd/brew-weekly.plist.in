<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for `make schedule`. @HOME@ is replaced with $HOME; launchd does not expand ~ or variables. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.dotfiles.brew-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@HOME@/.local/bin/brew-weekly</string>
  </array>
  <!-- Monday 10:00. A run missed during sleep starts on wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <!-- Catches errors before the script redirects its own output -->
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/brew-weekly.log</string>
</dict>
</plist>
